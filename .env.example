# Copy to .env and fill in. Never commit .env.
# Local: the Docker database from compose.yaml. Vercel: set by the Neon integration.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/oms

# Auth. Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that can always sign in, as admins.
OWNER_EMAILS=
# Vercel only (production and previews): shared by the OAuth proxy.
OAUTH_PROXY_SECRET=
